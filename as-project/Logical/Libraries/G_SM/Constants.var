VAR CONSTANT
	SIGNAL_TYPE_MASK : INT := 2#00000111;
	ALARM : INT := 2#00000001;
	ANOMALY : INT := 2#00000010;
	WARNING : INT := 2#00000011;
	INFORMATION : INT := 2#00000100;
	AUX_RESET : INT := 2#10100000;
	AUTO_CONDITIONED_RESET : INT := 2#01100000;
	NONE : DWORD := 16#0000;
	INIT : INT := 0;
	RUN : INT := 1;
	START_CONFIGURATION : INT := 2;
	CONFIGURATION : INT := 3;
	START_GENERATION : INT := 4;
	GENERATION : INT := 5;
	EMERGENCY_STOP : DWORD := 16#0001;
	IMMEDIATE_STOP : DWORD := 16#0002;
	ON_PHASE_STOP : DWORD := 16#0004;
	MATERIALS_RUN_OUT_LAMP : DWORD := 16#0006;
	MATERIALS_RUN_OUT_BUZZER : DWORD := 16#0008;
END_VAR
